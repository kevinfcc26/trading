# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brocker
DB_USER=brocker
DB_PASSWORD=brocker

# ─── Redis (event bus — production) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Options: "ollama" (local, free) | "claude" (Anthropic API) | "none" (TA+ML only)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434   # use http://ollama:11434 inside Docker
OLLAMA_MODEL=llama3.1:8b

# ─── Anthropic / Claude (only needed if AI_PROVIDER=claude) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── MetaTrader 5 (Windows only) ─────────────────────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo

# ─── Trading defaults ────────────────────────────────────────────────────────
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=M15
INITIAL_BALANCE=1000     # used as backtest starting balance and paper broker balance
DRY_RUN=true

# ─── Risk pipeline ───────────────────────────────────────────────────────────
RISK_PER_TRADE=0.01           # 1% of balance per trade
MAX_OPEN_POSITIONS=3
MAX_DAILY_DRAWDOWN=0.05       # 5% daily loss triggers kill switch
MAX_PORTFOLIO_EXPOSURE=0.06   # 6% total exposure limit

# ─── Risk profile ────────────────────────────────────────────────────────────
# Options: conservative | moderate | aggressive
# Profiles defined in config/settings.py — override individual values below if needed
TRADING_PROFILE=moderate

# Optional overrides (uncomment to override profile defaults):
# RISK_PER_TRADE=0.015
# MAX_OPEN_POSITIONS=2
# MIN_SIGNAL_THRESHOLD=0.52
# CLAUDE_VETO_THRESHOLD=0.70
# SR_MIN_RR_RATIO=2.0
# WEIGHT_TA=0.25
# WEIGHT_ML=0.35
# WEIGHT_CLAUDE=0.40

# ─── Learning / Knowledge ────────────────────────────────────────────────────
KNOWLEDGE_WATCH_DIR=docs/knowledge     # directory scanned by LearningWorker
KNOWLEDGE_STORE_PATH=models/knowledge.jsonl

# ─── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOOP_INTERVAL_SECONDS=60
